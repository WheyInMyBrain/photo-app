:80 {
    # 1. Specialized handling for long-lived SSE / stream connections
    handle /api/events* {
        reverse_proxy backend:3000 {
            flush_interval -1
            # Prevent Caddy from cutting idle/long-lived event streams
            transport http {
                response_header_timeout 0s
                read_timeout 0s
                write_timeout 0s
            }
        }
    }

    # 2. General API calls
    handle /api/* {
        reverse_proxy backend:3000 {
            flush_interval -1
        }
    }

    # 3. Static user assets & thumbnails served by Axum
    handle /users/* {
        reverse_proxy backend:3000
    }

    handle /thumbs/* {
        reverse_proxy backend:3000
    }

    # 4. Frontend (SvelteKit / SPA)
    handle {
        reverse_proxy frontend:3000
    }
}