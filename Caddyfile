# Reusable block containing all routing rules
(app_routes) {
    # 1. Specialized handling for long-lived SSE / stream connections
    handle /api/events* {
        reverse_proxy backend:3000 {
            flush_interval -1
            transport http {
                response_header_timeout 0s
                read_timeout 0s
                write_timeout 0s
            }
        }
    }

    # 2. General API calls go to Axum
    handle /api/* {
        reverse_proxy backend:3000 {
            flush_interval -1
        }
    }

    # 3. Serve generated thumbnails directly with immutable caching
    handle /thumbs/* {
        root * /data/storage
        file_server
        header {
            Cache-Control "public, max-age=31536000, immutable"
        }
    }

    # 4. Serve user media/originals directly from storage
    handle /users/* {
        root * /data/storage
        file_server
        header {
            Cache-Control "public, max-age=86400"
        }
    }

    # 5. Frontend (SvelteKit / SPA)
    handle {
        reverse_proxy frontend:3000
    }
}

# ---------------------------------------------------------
# Plain HTTP on port 80 -> Mapped to host port 4001
# (No TLS/SSL overhead or certificate checks)
# ---------------------------------------------------------
:80 {
    import app_routes
}

# ---------------------------------------------------------
# Encrypted HTTPS on port 443 -> Mapped to host port 3001
# ---------------------------------------------------------
:443 {
    tls /etc/ssl/server.crt /etc/ssl/server.key
    import app_routes
}