(app_routes) {
    # 0. Kasm Chrome VNC GUI & WebSockets
    handle_path /browser* {
        reverse_proxy https://chrome:6901 {
            transport http {
                tls
                tls_insecure_skip_verify
            }
        }
    }

    # 1. Specialized handling for long-lived SSE / stream connections
    handle /api/events* {
        reverse_proxy backend:3000 {
            flush_interval -1
            transport http {
                response_header_timeout 0s
                read_timeout 0s
                write_timeout 0s
            }
        }
    }

    # 2. General API calls go to Axum
    handle /api/* {
        reverse_proxy backend:3000 {
            flush_interval -1
        }
    }

    # 3. Serve generated thumbnails directly with immutable caching
    handle /thumbs/* {
        root * /data/storage
        file_server
        header {
            Cache-Control "public, max-age=31536000, immutable"
        }
    }

    # 4. Serve user media/originals directly from storage
    handle /users/* {
        root * /data/storage
        file_server
        header {
            Cache-Control "public, max-age=86400"
        }
    }

    # 5. Frontend (SvelteKit / SPA fallback)
    handle {
        reverse_proxy frontend:3000
    }
}

:80 {
    import app_routes
}

:443 {
    tls /etc/ssl/server.crt /etc/ssl/server.key
    import app_routes
}